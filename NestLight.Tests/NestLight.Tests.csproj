<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 matches the extension and runs in any VS with the .NET development workload.
         net10.0 lets the same tests run with `dotnet test` on any OS (including Linux CI, which has no .NET Framework). -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>NestLight.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Everything but VisualStudio\ is shared (linked) with the extension; it does not depend on the VS SDK. -->
  <ItemGroup>
    <Compile Include="..\NestLight\Common\**\*.cs" LinkBase="Source\Common" />
    <Compile Include="..\NestLight\Hosts\**\*.cs" LinkBase="Source\Hosts" />
    <Compile Include="..\NestLight\Languages\**\*.cs" LinkBase="Source\Languages" />
    <Compile Include="..\NestLight\Highlighting\**\*.cs" LinkBase="Source\Highlighting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
