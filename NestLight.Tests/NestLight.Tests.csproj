<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 to match the extension and run in any VS with the .NET development workload -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>NestLight.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Everything but VisualStudio\ is shared (linked) with the extension; it does not depend on the VS SDK. -->
  <ItemGroup>
    <Compile Include="..\NestLight\Common\**\*.cs" LinkBase="Source\Common" />
    <Compile Include="..\NestLight\Hosts\**\*.cs" LinkBase="Source\Hosts" />
    <Compile Include="..\NestLight\Languages\**\*.cs" LinkBase="Source\Languages" />
    <Compile Include="..\NestLight\Highlighting\**\*.cs" LinkBase="Source\Highlighting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
